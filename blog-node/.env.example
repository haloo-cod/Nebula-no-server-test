# GitHub + R2 模式不需要数据库；仅启用账号、评论或自建统计时填写 DATABASE_URL。
DATABASE_URL=
SECRET_KEY=replace-with-a-random-string-at-least-32-characters
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false

# GitHub Contents API：Markdown 和 JSON 小内容的仓库位置。
# Token 只放在 Node/Vercel 服务端环境变量中，浏览器不会读取它。
GITHUB_CONTENT_TOKEN=
GITHUB_REPOSITORY=owner/repository
GITHUB_CONTENT_BRANCH=main
GITHUB_CONTENT_ROOT=content
# GitHub OAuth：回调地址必须与 GitHub OAuth App 中完全一致。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8787/api/v1/auth/github/callback

# Cloudflare R2（五项全部填写后启用上传）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://cdn.example.com
# 直传 R2 时，bucket CORS 至少允许前端域名发起 PUT/HEAD。
# 本地预览通常填：http://localhost:5173
# 在 Cloudflare R2 Bucket -> Settings -> CORS 中添加规则（按实际生产域名补充 AllowedOrigins）：
# {
#   "AllowedOrigins": ["http://localhost:5173", "https://你的前端域名"],
#   "AllowedMethods": ["GET", "HEAD", "PUT"],
#   "AllowedHeaders": ["*"],
#   "ExposeHeaders": ["ETag", "Content-Length", "Content-Range"],
#   "MaxAgeSeconds": 3600
# }

# CORS；逗号分隔多个来源
CORS_ORIGINS=http://localhost:5173
ANALYTICS_HASH_SALT=replace-with-a-random-string-at-least-32-characters
