# GitHub + R2 模式不需要数据库；仅启用账号、评论或自建统计时填写 DATABASE_URL。
DATABASE_URL=
SECRET_KEY=replace-with-a-random-string-at-least-32-characters
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false

# GitHub Contents API：Markdown 和 JSON 小内容的仓库位置。
# Token 只放在 Node/Vercel 服务端环境变量中，浏览器不会读取它。
GITHUB_CONTENT_TOKEN=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
GITHUB_REPOSITORY=haloo-cod/Nebula-content
GITHUB_CONTENT_BRANCH=main
GITHUB_CONTENT_ROOT=content

