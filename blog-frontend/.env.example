VITE_USE_API=true
# 内容来源：api（默认，连接 Node API）或 static（Vercel/纯静态托管）。
VITE_CONTENT_MODE=api
# static 模式下 EPUB 清单中的相对 key 会拼接此 R2 公共域名，例如 https://cdn.example.com。
VITE_R2_PUBLIC_URL=
# 访问统计：Vercel 部署填 vercel；留空则关闭自建统计上报。
VITE_ANALYTICS_PROVIDER=
# 本地 Node API 填写 http://localhost:8787；同域生产部署留空。
VITE_API_BASE_URL=
